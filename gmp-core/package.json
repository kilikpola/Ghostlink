{
  "name": "@ghostlink/gmp-core",
  "version": "0.0.3",
  "description": "Ghost Mesh Protocol — GhostLink's peer-to-peer encrypted mesh networking stack",
  "type": "module",
  "main": "dist/gmp-node-manager.js",
  "exports": {
    ".": "./dist/gmp-node-manager.js",
    "./bridge": "./dist/gmp-bridge.js",
    "./config": "./dist/config.js",
    "./logger": "./dist/logger.js",
    "./metrics": "./dist/metrics.js"
  },
  "bin": {
    "gmp": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node test/run-all.mjs",
    "test:two-node": "node test/two-node-test.js",
    "test:nonce": "node test/nonce-persistence-test.js",
    "test:rate": "node test/rate-limit-test.js",
    "test:binding": "node test/binding-test.js",
    "test:nat": "node test/nat-detection-test.js",
    "test:hole-punch": "node test/hole-punch-test.js",
    "test:multihop": "node test/multi-hop-test.js",
    "test:topology": "node test/topology-maintenance-test.js",
    "test:ghost-address": "node test/ghost-address-test.js && node test/ghost-address-parity-test.js && node test/bridge-ghost-address-test.js && node test/lan-discovery-test.js",
    "test:all": "node test/run-all.mjs"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3"
  }
}
