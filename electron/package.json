{
  "name": "ghostlink-desktop",
  "version": "0.0.3",
  "description": "GhostLink — Zero Trust, Zero Trace, Zero Servers",
  "author": {
    "name": "GhostLink",
    "email": "ghostlink@proton.me"
  },
  "homepage": "https://github.com/kilikpola/Ghostlink",
  "license": "GPL-3.0",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild:dir": "node scripts/prepare-packaging.cjs",
    "build:dir": "electron-builder --dir",
    "prebuild:win": "node scripts/prepare-packaging.cjs",
    "build:win": "electron-builder --win",
    "prebuild:mac": "node scripts/prepare-packaging.cjs",
    "build:mac": "electron-builder --mac",
    "prebuild:linux": "node scripts/prepare-packaging.cjs",
    "build:linux": "electron-builder --linux",
    "prebuild:all": "node scripts/prepare-packaging.cjs",
    "build:all": "electron-builder --win --mac --linux"
  },
  "build": {
    "appId": "com.ghostlink.desktop",
    "productName": "GhostLink",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../index.html",
        "to": "webapp/index.html"
      },
      {
        "from": "../app.bundle.js",
        "to": "webapp/app.bundle.js"
      },
      {
        "from": "../vendor",
        "to": "webapp/vendor"
      },
      {
        "from": "../src",
        "to": "webapp/src"
      },
      {
        "from": "../shared",
        "to": "webapp/shared"
      },
      {
        "from": "../assets",
        "to": "webapp/assets"
      },
      {
        "from": "../gmp-core/dist",
        "to": "gmp-core/dist"
      },
      {
        "from": "../gmp-core/package.json",
        "to": "gmp-core/package.json"
      },
      {
        "from": "../gmp-core/data/public-peers.example.json",
        "to": "gmp-core/data/public-peers.example.json"
      },
      {
        "from": "../node_modules/ws",
        "to": "gmp-core/node_modules/ws"
      },
      {
        "from": "../node_modules/@noble/curves",
        "to": "gmp-core/node_modules/@noble/curves"
      },
      {
        "from": "../node_modules/@noble/hashes",
        "to": "gmp-core/node_modules/@noble/hashes"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "category": "public.app-category.social-networking"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  }
}
