node_modules
license-generator/
license-test.html
test-license.html
gmp-core/data/*
!gmp-core/data/public-peers.example.json

# Only the archived design/audit reports stay out of the tree. The previous
# blanket *.md/*.txt rule silently swallowed every new doc (CONTRIBUTING.md,
# CHANGELOG.md, docs/*.md) at `git add` time. Scope the ignore instead.
docs/archive/*.md
docs/archive/*.txt

# Local environment (real values). .env.example is the committed template.
.env
.env.*
!.env.example

# TLS certs / keys (mkcert + self-signed) — never commit private keys
*.pem
*.pem.*

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Backups and temporary files
*.bak
*~
*.swp
*.bin
small_test.txt

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/

# AI tool internals
.claude/
.opencode/
.antigravity/
.aider*
CLAUDE.md
.cursorrules
gmp-core/dist/

# electron-builder output (desktop installers / unpacked dirs)
electron/dist/

# Android release signing — losing these means never being able to update the
# app, but committing them means anyone can sign a build as us.
mobile/android/app/*.keystore
!mobile/android/app/debug.keystore
mobile/android/keystore.properties
mobile/android/local.properties
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/

# Marketing site — kept out of the repo, built and deployed separately.
landing.html
ghostlink-website.html
assets/site-shell.css
assets/app-screenshot.png
*.apk
*.aab

# One archived doc is referenced by the deployment guide and stays tracked.
!docs/archive/DEPLOYMENT.md
mobile/android/app/src/main/res/drawable-*/

# Generated React Native bundle. Committing it makes reviewers read minified
# output instead of source — a CodeRabbit pass produced six findings against
# this file alone, all of which had to be traced back by hand. It is rebuilt by
# `npx react-native bundle` and by every release build.
mobile/android/app/src/main/assets/index.android.bundle
mobile/android/app/src/main/res/drawable-*/

# Transient stubs written by tests that load mobile/src from Node
mobile/.crypto-under-test-*.mjs
mobile/.roundtrip-*.mjs

# AI agent skill files — kept locally, not published.
.agents/
